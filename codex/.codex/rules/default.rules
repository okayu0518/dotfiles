prefix_rule(pattern=["git", "rev-parse", "--short", "HEAD"], decision="allow")
prefix_rule(pattern=["git", "status", "--short", "--branch"], decision="allow")
prefix_rule(pattern=["sed", "-n", "1,200p", "docs/findings/2026-09-14-ppo-learns-no-latency-avoidance-at-100x100.md"], decision="allow")
prefix_rule(pattern=["rg", "--files"], decision="allow")
prefix_rule(pattern=["sed", "-n", "1,260p", "paper/paper-uav-iot.tex"], decision="allow")
prefix_rule(pattern=["sed", "-n", "1,180p", "docs/findings/2026-09-11-compute-advantage-over-latency-aware-astar.md"], decision="allow")
prefix_rule(pattern=["sed", "-n", "380,660p", "src/uav_rl_workbench/envs.py"], decision="allow")
prefix_rule(pattern=["rg", "-n", "^\\\\(section|subsection|paragraph|begin\\{abstract\\}|end\\{abstract\\}|TODO|hogehoge|will|propose|superior|contribution|collision|result|Conclusion|CONCLUSION)", "paper/paper-uav-iot.tex"], decision="allow")
prefix_rule(pattern=["/bin/bash", "-lc", "sed -n '560,740p' paper/paper-uav-iot.tex && rg -n 'objective|mean_violating|qualified_mission_success|collision' docs/exp-report-paper-ppo/README.md docs/exp-report-100x100-quality-recovery/README.md docs/findings/2026-09-14-*"], decision="allow")
prefix_rule(pattern=["rg", "-n", "^claim:", "docs/findings"], decision="allow")
prefix_rule(pattern=["git", "status", "--short"], decision="allow")
prefix_rule(pattern=["sed", "-n", "330,425p", "src/uav_rl_workbench/envs.py"], decision="allow")
prefix_rule(pattern=["sed", "-n", "1,320p", "paper/scripts/make_figures.py"], decision="allow")
prefix_rule(pattern=["sed", "-n", "320,700p", "paper/scripts/make_figures.py"], decision="allow")
prefix_rule(pattern=["sed", "-n", "1,240p", "paper/data/manifest.json"], decision="allow")
prefix_rule(pattern=["sed", "-n", "1,240p", "docs/exp-report-paper-ppo/README.md"], decision="allow")
